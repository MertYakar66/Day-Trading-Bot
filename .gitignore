# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Environment / secrets — never commit
.env
.envrc
*creds*.txt
*_credentials.json

# OS / editor
.DS_Store
.idea/
.vscode/

# NOTE: the regenerable parquet data store is ignored by data_store/.gitignore
# (keeps the directory, ignores its contents). Do not add data_store/ here, or
# that .gitignore itself would be ignored.

# Raw vendor data pulls (large, regenerable from IBKR/Theta — never committed).
# Small captured slices used as test fixtures live under tests/fixtures/ instead.
data_raw/

# Generated dashboards (regenerable via `python -m intraday report`). The tracked
# illustrative example lives at docs/sample_dashboard.html.
/dashboard.html
/*.dashboard.html
